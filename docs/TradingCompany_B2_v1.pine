//@version=6
indicator("Trading Company | B2 Regime Momentum v1.0", overlay=true, max_labels_count=500)
// Research only. Chart volume is NOT Dukascopy bid+ask volume; verify parity before forward testing.
// Source: AlgoAlpha-style ZLEMA bands (70, 1.2); HMA(50)/3 approximation from v8.
if timeframe.in_seconds() != 60
    runtime.error("Gebruik een gewone M1-kaarsgrafiek.")
f_trend() =>
    z = ta.ema(close + (close - close[34]), 70)
    b = ta.highest(ta.atr(70), 210) * 1.2
    var int t = 0
    if ta.crossover(close, z + b)
        t := 1
    if ta.crossunder(close, z - b)
        t := -1
    t
f_prev() =>
    t = f_trend()
    t[1]
t1 = f_trend()
t5 = request.security(syminfo.tickerid, "5", f_prev(), lookahead=barmerge.lookahead_on)
d = t1 != 0 and t1 != t1[1] ? t1 : 0
e = ta.ema(close, 50)
h = ta.hma(close, 50)
var int hs = 0
if h > h[1] and h > h[2] and h > h[3]
    hs := 1
else if h < h[1] and h < h[2] and h < h[3]
    hs := -1
a = ta.atr(14)
r = high-low
body = r > 0 ? math.abs(close-open)/r : 0
edge = r > 0 ? (d == 1 ? (high-close)/r : (close-low)/r) : 1
strong = body >= 0.50 and d*(close-open)>0 and edge<=0.20
rv = volume / ta.sma(volume[1], 20)
path = math.sum(math.abs(ta.change(close)), 20)
er = path>0 and time-time[20]==20*60000 ? math.abs(close-close[20])/path : na
// Previous 20 COMPLETE UTC days with >=600 observed M1 bars, median of daily medians.
var array<float> samples = array.new_float()
var array<float> medians = array.new_float()
utcDay = int(math.floor(time/86400000))
if barstate.isconfirmed
    if not na(utcDay[1]) and utcDay != utcDay[1]
        if array.size(samples)>=600
            array.push(medians,array.median(samples))
            if array.size(medians)>20
                array.shift(medians)
        array.clear(samples)
    if not na(a) and close>0 and not na(volume) and volume>0
        array.push(samples,a/close*10000)
ref = array.size(medians)==20 ? array.median(medians) : na
rel = a/close*10000/ref
// Explicit verified spread snapshot from selected broker. No fake historical spread.
spread = input.float(0.0,"BID/ASK spread USD per oz (actueel)",minval=0,step=0.01,group="Broker")
spreadAt = input.time(timestamp("01 Jan 2020 00:00 +0000"),"Tijdstip gemeten spread",group="Broker")
minOz = input.float(0.15,"Minimum ounces",minval=0.01,step=0.01,group="Broker")
stepOz = input.float(0.15,"Stap ounces",minval=0.01,step=0.01,group="Broker")
fx = input.float(0.0,"Actuele EUR/USD (USD per EUR)",minval=0,step=0.0001,group="Broker")
verified = input.bool(false,"Brokercontract, quote en volume-bron gecontroleerd",group="Broker")
freeMargin = input.float(0.0,"Actuele vrije margin EUR (5% goudmarge)",minval=0,group="Broker")
minStop = input.float(0.0,"Minimale stopafstand USD/oz (broker)",minval=0,group="Broker")
risk = input.float(5.0,"Gepland risico EUR",minval=0.1,maxval=5,group="Broker")
slip = input.float(0.10,"Stop-slippage USD/oz",minval=0,step=0.01,group="Broker")
fees = input.float(0.0,"Extra commissie retour USD (totale order)",minval=0,group="Broker")
manualPause = input.bool(false,"Pauze bij onverwacht nieuws",group="Nieuws")
// Calendar snapshot verified 12 Nov 2026, valid only 13 Nov–31 Dec. Recheck before session.
calendarChecked = input.bool(false,"Kalender vandaag opnieuw gecontroleerd",group="Nieuws")
calendarAt = input.time(timestamp("01 Jan 2020 00:00 +0000"),"Tijdstip kalendercontrole",group="Nieuws")
f_window(int ev) =>
    time_close>=ev-5*60000 and time_close<=ev+15*60000
news = f_window(timestamp("America/New_York",2026,12,4,8,30)) or f_window(timestamp("America/New_York",2026,12,9,14,0)) or f_window(timestamp("America/New_York",2026,12,9,14,30)) or f_window(timestamp("America/New_York",2026,12,10,8,30))
covered = time_close>=timestamp("13 Nov 2026 00:00 +0000") and time_close<timestamp("01 Jan 2027 00:00 +0000")
calendarFresh = calendarChecked and time_close>=calendarAt and time_close-calendarAt<=86400000
quoteOK = spread>0 and fx>0 and time_close>=spreadAt and time_close-spreadAt<=5*60000 and verified
planned = 3*a+slip+spread
qty = quoteOK and planned>0 ? math.floor(math.min(1.0,math.max(0,risk*fx-fees)/planned)/stepOz)*stepOz : 0.0
tech = barstate.isconfirmed and d!=0 and d*(close-e)>0 and t5==d and hs==d and strong and rv>=1.5 and rel>=1 and rel<=3 and er>=0.30
eligible = tech and quoteOK and spread<=0.5*a and covered and calendarFresh and not news and not manualPause and qty>=minOz and freeMargin>0 and qty*close*0.05/fx<=freeMargin and 3*a>=minStop
// Research position state: pending entry on next M1 open; chart OHLC proxy, NOT executable bid/ask fills.
// If a stop is crossed in the same bar, conservatively model it as hit; no actual order.
var int paperPos = 0
var int pending = 0
var int pendingExit = 0
var float pendingATR = na
var float paperStop = na
var float paperQty = na
var float entryProxy = na
bool opened = false
bool closed = false
if barstate.isconfirmed
    if paperPos != 0 and pendingExit != 0
        paperPos := 0
        pendingExit := 0
        paperStop := na
        closed := true
    if pending != 0 and paperPos == 0
        // Reject missing next minute rather than assume a gap fill.
        if time-time[1]==60000
            paperPos := pending
            entryProxy := open
            paperStop := open-paperPos*3*pendingATR
            opened := true
        pending := 0
    if paperPos != 0 and (paperPos==1 ? low<=paperStop : high>=paperStop)
        paperPos := 0
        paperStop := na
        closed := true
    if paperPos != 0 and d==-paperPos
        pendingExit := 1
    if eligible and (paperPos==0 or pendingExit!=0)
        pending := d
        pendingATR := a
        paperQty := qty
plot(paperPos!=0?paperStop:na,"Paper ATR-stop (OHLC proxy)",color=color.yellow,style=plot.style_linebr)
plotshape(closed,title="Paper EXIT proxy",style=shape.xcross,location=location.abovebar,color=color.yellow,size=size.tiny)
plotshape(opened,title="Paper entry next candle proxy",style=shape.circle,location=location.belowbar,color=color.blue,size=size.tiny)
// Mark technical candidates separately from validated PAPER eligibility. No live orders or P&L claims.
plot(e,"EMA50",color=color.orange)
plot(h,"HMA50 (benadering)",color=hs==1?color.teal:color.red)
plotshape(tech and d==1,title="B2 technische kandidaat long",style=shape.triangleup,location=location.belowbar,color=color.new(color.teal,25),size=size.small,text="B2?")
plotshape(tech and d==-1,title="B2 technische kandidaat short",style=shape.triangledown,location=location.abovebar,color=color.new(color.red,25),size=size.small,text="B2?")
plotshape(eligible and d==1,title="Paper LONG",style=shape.labelup,location=location.belowbar,color=color.green,text="P LONG",size=size.small)
plotshape(eligible and d==-1,title="Paper SHORT",style=shape.labeldown,location=location.abovebar,color=color.maroon,text="P SHORT",size=size.small)
var table tb=table.new(position.top_right,2,11,border_width=1)
f_row(int i,string label,string value) =>
    table.cell(tb,0,i,label,text_color=color.white,bgcolor=color.rgb(24,36,50))
    table.cell(tb,1,i,value,text_color=color.white,bgcolor=color.rgb(35,50,66))
if barstate.islast
    f_row(0,"B2 | onderzoek",eligible?"PAPER KANDIDAAT":"WACHTEN")
    f_row(1,"Grote AA-pijl",d==1?"BUY":d==-1?"SELL":"Geen")
    f_row(2,"M5 gesloten / HMA",str.tostring(t5)+" / "+str.tostring(hs))
    f_row(3,"Body / rand",str.tostring(body,"0.00")+" / "+str.tostring(edge,"0.00"))
    f_row(4,"Relatief volume",str.tostring(rv,"0.00"))
    f_row(5,"ATR / normaal",str.tostring(rel,"0.00"))
    f_row(6,"ER20",str.tostring(er,"0.00"))
    f_row(7,"Spread/ATR",quoteOK?str.tostring(spread/a,"0.00"):"ONBEKEND")
    f_row(8,"Nieuws",not covered or not calendarFresh?"ONBEKEND":news or manualPause?"BLOK":"Vrij")
    f_row(9,"Positie oz",quoteOK?str.tostring(qty,"0.00"):"ONBEKEND")
    f_row(10,"Bronpariteit","Nog te valideren")
if eligible and pending != 0
    alert("B2 PAPER | "+syminfo.ticker+" | "+(d==1?"LONG":"SHORT")+" | oz "+str.tostring(qty)+" | ATR "+str.tostring(a)+" | volgende M1 open controleren; geen order",alert.freq_once_per_bar_close)
if barstate.isconfirmed and pendingExit!=0
    alert("B2 EXIT CHECK | "+syminfo.ticker+" | grote pijl "+(d==1?"BUY":"SELL")+" | sluit tegengestelde paperpositie op volgende M1; stop blijft actief",alert.freq_once_per_bar_close)
